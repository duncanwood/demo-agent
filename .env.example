# ---- provider mode ----
PROVIDER_MODE=cloud                 # cloud | local

# ---- target ----
DEMO_TARGET_URL=https://metric-master-suite505.apps.rebolt.ai/
CONTEXT_URL=                        # optional company/landing URL distilled at demo start
# The target app is gated (email/password, self-serve signup). Provide a login,
# or capture a Playwright storage_state once and point STORAGE_STATE at it.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
STORAGE_STATE=                      # optional path to saved auth state json

# ---- cloud providers (PROVIDER_MODE=cloud) ----
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
OPENAI_MODEL=gpt-4o
CARTESIA_VOICE_ID=

# ---- local providers (PROVIDER_MODE=local) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
# Whisper (STT) and Kokoro (TTS) run in-process; no keys needed.
