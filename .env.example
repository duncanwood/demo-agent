# ---- target ----
DEMO_TARGET_URL=https://metric-master-suite505.apps.rebolt.ai/
# Optional company/landing URL distilled at demo start (defaults to the target itself).
CONTEXT_URL=
# The target app is gated (email/password, self-serve signup). Provide a login,
# leave blank to log in manually in the window (detected and saved), or point
# STORAGE_STATE at a saved auth state.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
# Optional path for saved auth state (default .auth-state.json; skips login on later runs).
STORAGE_STATE=

# ---- providers (all have free tiers; the first-run setup page fills these) ----
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional — defaults to "Blake" (conversational male) from the Cartesia catalog.
CARTESIA_VOICE_ID=
