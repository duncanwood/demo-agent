# ---- provider mode: cloud | local ----
PROVIDER_MODE=cloud

# ---- target ----
DEMO_TARGET_URL=https://metric-master-suite505.apps.rebolt.ai/
# Optional company/landing URL distilled at demo start (defaults to the target itself).
CONTEXT_URL=
# The target app is gated (email/password, self-serve signup). Provide a login,
# or capture a Playwright storage_state once and point STORAGE_STATE at it.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
# Optional path for saved auth state (skips login on later runs).
STORAGE_STATE=

# ---- cloud providers (PROVIDER_MODE=cloud) ----
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional — defaults to "Blake" (conversational male) from the Cartesia catalog.
CARTESIA_VOICE_ID=

# ---- local providers (PROVIDER_MODE=local) ----
# Whisper (STT) and Kokoro (TTS) run in-process; no keys needed. Run Ollama separately.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
